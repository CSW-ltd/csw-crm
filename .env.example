# Nusxa oling: cp .env.example .env  — va qiymatlarni almashtiring

# MySQL
MYSQL_DATABASE=csw_crm
MYSQL_USER=csw
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# Backend
APP_ENV=development
JWT_SECRET=change-me-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
GPS_RADIUS_DEFAULT_M=300

# MinIO
MINIO_ACCESS_KEY=csw-minio
MINIO_SECRET_KEY=change-me-minio
MINIO_BUCKET=csw-files
MINIO_SECURE=false
MINIO_REGION=

# Faol rollar (bo'sh — hammasi). Prod 1-bosqich: admin,manager,legal,accountant
ACTIVE_ROLES=

# Demo loginlari (seed): har rolga bitta, JSON. Har parol kamida 8 belgi, harf va raqam. Haqiqiy parollarni faqat .env'ga yozing.
# Placeholder ataylab yaroqsiz (seed rad etadi). Parolda $ ishlatmang (compose uni o'zgaruvchi deb o'qiydi).
DEMO_CREDENTIALS={"csw.admin":"CHANGE_ME","csw.manager":"CHANGE_ME","csw.yurist":"CHANGE_ME","csw.buxgalter":"CHANGE_ME","csw.operator":"CHANGE_ME","csw.gps":"CHANGE_ME","csw.haydovchi":"CHANGE_ME"}
