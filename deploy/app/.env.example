# csw-app (prod): cp .env.example .env && chmod 600 .env — qiymatlarni almashtiring
# Baza (csw-db)
DB_HOST=10.0.0.X                # csw-db ichki VPC IP
MYSQL_DATABASE=csw_crm
MYSQL_USER=csw
MYSQL_PASSWORD=change-me

# Edge nginx
PROD_DOMAIN=crm.csw.uz
TEST_DOMAIN=test.csw.uz
TEST_UPSTREAM=10.0.0.Y:8080     # csw-test ichki VPC IP:8080

# Backend (APP_ENV=production compose'da qotirilgan; xavfsiz bo'lmagan sozlamalar bilan api ishga tushmaydi)
JWT_SECRET=change-me-openssl-rand-base64-48
COOKIE_SECURE=true
CORS_ORIGINS=https://crm.csw.uz
PUBLIC_BASE_URL=https://crm.csw.uz
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
GPS_RADIUS_DEFAULT_M=300
# 1-bosqich: faqat shu rollar kira oladi (admin har doim faol)
ACTIVE_ROLES=admin,manager,legal,accountant

# Fayllar: UzCloud S3
MINIO_ENDPOINT=s3.uzcstorage.uz
MINIO_SECURE=true
MINIO_REGION=default
MINIO_BUCKET=csw-files
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me

# Ixtiyoriy
INTEGRATION_API_KEY=
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
