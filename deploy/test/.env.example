# csw-test: cp .env.example .env && chmod 600 .env — prod'dan BOSHQA parollar va JWT_SECRET
BIND_IP=10.0.0.Y                # csw-test ichki VPC IP (edge nginx shu yerga proksi qiladi)
MYSQL_DATABASE=csw_crm
MYSQL_USER=csw
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
MINIO_ACCESS_KEY=csw-minio
MINIO_SECRET_KEY=change-me-minio
MINIO_BUCKET=csw-files

JWT_SECRET=change-me-openssl-rand-base64-48
COOKIE_SECURE=true
CORS_ORIGINS=https://admin.test.csw.uz,https://manager.test.csw.uz,https://legal.test.csw.uz,https://account.test.csw.uz,https://call.test.csw.uz,https://gps.test.csw.uz,https://driver.test.csw.uz
PUBLIC_BASE_URL=https://account.test.csw.uz
# Har rol o'z test subdomenida (csw-app'dagi TEST_HOSTS bilan mos)
ROLE_HOSTS={"admin.test.csw.uz":["admin"],"manager.test.csw.uz":["manager"],"legal.test.csw.uz":["legal"],"account.test.csw.uz":["accountant"],"call.test.csw.uz":["operator"],"gps.test.csw.uz":["gps"],"driver.test.csw.uz":["driver"]}
# Demo rejim: barcha rollar ochiq, login sahifasida demo chiplari, har tabda alohida sessiya
APP_ENV=demo
TAB_SESSIONS=true
ACTIVE_ROLES=
# Placeholder ataylab yaroqsiz (seed rad etadi). Parolda $ ishlatmang (compose uni o'zgaruvchi deb o'qiydi).
DEMO_CREDENTIALS={"csw.admin":"CHANGE_ME","csw.manager":"CHANGE_ME","csw.yurist":"CHANGE_ME","csw.buxgalter":"CHANGE_ME","csw.operator":"CHANGE_ME","csw.gps":"CHANGE_ME","csw.haydovchi":"CHANGE_ME"}
