# csw-db zaxira sozlamalari: cp backup.env.example backup.env && chmod 600 backup.env
# age ochiq kaliti (maxfiy kalit serverda SAQLANMAYDI): age-keygen -o key.txt — oflayn kompyuterda
AGE_RECIPIENT=age1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BACKUP_LOCAL_DIR=/var/backups/csw
BACKUP_LOCAL_KEEP_DAYS=7
BACKUP_S3_KEEP_DAYS=90
BACKUP_REMOTE=uzs3:csw-backups-<CRN>/db   # UzCloud bucket nomi + mijoz raqami (paneldagi aniq nom)
# rclone S3 (UzCloud) — faqat csw-backups bucket'iga yozish huquqli alohida kalit
RCLONE_CONFIG_UZS3_TYPE=s3
RCLONE_CONFIG_UZS3_PROVIDER=Other
RCLONE_CONFIG_UZS3_ENDPOINT=https://s3.uzcstorage.uz
RCLONE_CONFIG_UZS3_REGION=default
RCLONE_CONFIG_UZS3_ACCESS_KEY_ID=change-me
RCLONE_CONFIG_UZS3_SECRET_ACCESS_KEY=change-me
